# =========================================================================
#  Backend Environment Variables
#  انسخ هذا الملف إلى .env ثم عدّل القيم
#  cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
#  SERVER
# -------------------------------------------------------------------------
# بيئة التشغيل: development | production | test
NODE_ENV=development

# المنفذ الذي يعمل عليه الـ backend
PORT=5000

# -------------------------------------------------------------------------
#  DATABASE (PostgreSQL)
# -------------------------------------------------------------------------
# رابط الاتصال بقاعدة البيانات
# - على Termux محلياً:
DATABASE_URL=postgresql://mlm_user@localhost:5432/mlm_casino
#
# - على سيرفر سحابي (Neon / Supabase / Railway):
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
#
# - على VPS مع Postgres محلي:
# DATABASE_URL=postgresql://user:password@localhost:5432/mlm_casino

# تفعيل SSL لقاعدة البيانات (يجب true على السيرفرات السحابية)
DB_SSL=false

# التحقق من شهادة SSL (اتركه false فقط للتطوير)
DB_SSL_REJECT_UNAUTHORIZED=false

# شهادة SSL (اختياري - اتركه فارغاً إذا لم تكن مطلوبة)
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# -------------------------------------------------------------------------
#  JWT AUTHENTICATION
# -------------------------------------------------------------------------
# 🔴 حرج: استخدم نصاً عشوائياً 32 حرفاً على الأقل
# يمكنك توليد واحد عبر: openssl rand -hex 32
JWT_SECRET=change_me_to_a_very_long_random_string_of_min_32_chars
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------------
#  BINANCE SMART CHAIN (BSC)
# -------------------------------------------------------------------------
# عنوان RPC العام (يمكن استبداله بـ QuickNode / Ankr للسرعة)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# معرف الشبكة (56 = BSC Mainnet، 97 = Testnet)
BSC_CHAIN_ID=56

# عنوان عقد USDT BEP-20 الرسمي على BSC
USDT_BEP20=0x55d398326f99059fF775485246999027B3197955

# 🔴 حرج: عنوان محفظة المنصة (التي تستقبل الإيداعات)
# يجب أن يكون عنوان BEP-20 صحيح (0x...)
PLATFORM_WALLET=0x0000000000000000000000000000000000000000

# عدد التأكيدات المطلوبة قبل اعتبار المعاملة نهائية (موصى به 3)
MIN_CONFIRMATIONS=3

# -------------------------------------------------------------------------
#  ADMIN
# -------------------------------------------------------------------------
# إيميل حساب الأدمن (هذا الحساب يحصل على صلاحيات كاملة)
ADMIN_EMAIL=admin@cryptoplay.io

# -------------------------------------------------------------------------
#  CORS
# -------------------------------------------------------------------------
# النطاقات المسموح لها بالاتصال (افصل بينها بفاصلة)
# للتطوير:
CORS_ORIGIN=http://localhost:3000
# للإنتاج (مثال):
# CORS_ORIGIN=https://cryptoplay.io,https://www.cryptoplay.io
